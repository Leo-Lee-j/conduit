---
import '../styles/global.css';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found — Conduit</title>
  </head>
  <body>
    <main class="container missing-page">
      <p class="eyebrow">Conduit / 404</p>
      <h1>This page has moved<br />or doesn’t exist.</h1>
      <p lang="zh-CN">页面不存在，或已移动。可以从首页重新开始。</p>
      <div><a class="button primary" href={base}>Back to home</a><a class="button" href={`${base}zh-cn/`} lang="zh-CN">返回中文首页</a></div>
    </main>
  </body>
</html>
<style>
  .missing-page { padding-block: 100px; }
  .missing-page h1 { font-size: clamp(32px, 6vw, 60px); letter-spacing: -1.5px; }
  .missing-page > p:not(.eyebrow) { margin-block: 32px; color: var(--muted); }
  .missing-page > div { display: flex; gap: 16px; flex-wrap: wrap; }
</style>
