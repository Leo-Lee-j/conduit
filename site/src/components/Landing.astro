---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { copy, repository, download, guide, type Locale } from '../content';
import '../styles/global.css';
import logo from '../../../assets/app-icons/128x128.png';
import workspace from '../../../assets/screenshots/workspace.png';
import review from '../../../assets/screenshots/git-review.png';
import usage from '../../../assets/screenshots/usage-insights.png';
import claude from '../../../assets/icons/claudecode.svg?raw';
import codex from '../../../assets/icons/codex.svg?raw';
import opencode from '../../../assets/icons/opencode.svg?raw';
import qoder from '../../../assets/icons/qoder.svg?raw';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(`${base}${locale === 'zh' ? 'zh-cn/' : ''}`, Astro.site);
const socialImage = new URL(`${base}social.png`, Astro.site);
const engines = [
  { name: 'Claude Code', icon: claude },
  { name: 'Codex', icon: codex },
  { name: 'OpenCode', icon: opencode },
  { name: 'Qoder CLI', icon: qoder },
];
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#f6f5f0" />
    <link rel="icon" type="image/png" href={logo.src} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(base, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(`${base}zh-cn/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Conduit" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Conduit — Your agents. One workspace." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header container">
      <a class="brand" href={canonical.pathname} aria-label={t.home}>
        <img src={logo.src} width="34" height="34" alt="" />
        <span>Conduit</span>
      </a>
      <nav aria-label={t.navigation}>
        <a class="desktop-link" href="#workspace">{t.workflow}</a>
        <a class="desktop-link" href="#start">{t.start}</a>
        <a class="language-link" href={`${base}${t.switchPath}`} lang={t.switchLang} hreflang={t.switchLang}>{t.switchLanguage}</a>
        <a class="nav-github" href={repository}>GitHub <Arrow direction="up-right" /></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <p class="eyebrow"><span class="small-mark" aria-hidden="true"></span>{t.intro}</p>
        <div class="hero-copy">
          <h1 id="hero-title">{t.headline[0]}<br /><em>{t.headline[1]}</em></h1>
          <div class="hero-intro">
            <p class="lead">{t.lead}</p>
            <a class="button primary" href={download}>{t.download}<Arrow direction="down" /></a>
            <p class="download-note">{t.downloadNote}</p>
          </div>
        </div>
        <figure class="hero-figure">
          <a class="screenshot-link" href={workspace.src} target="_blank" rel="noopener" aria-label={`${t.enlarge}: ${t.screenshotCaption}`}>
            <Image src={workspace} alt={t.screenshotAlt} widths={[640, 1024, 1664]} sizes="(max-width: 720px) calc(100vw - 32px), (max-width: 1240px) calc(100vw - 80px), 1160px" format="webp" quality={90} loading="eager" fetchpriority="high" />
          </a>
          <figcaption><span>{t.screenshotCaption}</span><a href={workspace.src} target="_blank" rel="noopener">{t.enlarge}<Arrow direction="up-right" /></a></figcaption>
        </figure>
        <div class="engine-strip">
          <div class="engine-copy"><p>{t.enginesTitle}</p><span>{t.enginesNote}</span></div>
          <ul aria-label="CLI">
            {engines.map(engine => <li><span class="engine-icon" aria-hidden="true"><Fragment set:html={engine.icon} /></span>{engine.name}</li>)}
          </ul>
        </div>
      </section>

      <section id="workspace" class="workspace-section container" aria-labelledby="workspace-title">
        <p class="eyebrow">{t.sectionIntro}</p>
        <h2 id="workspace-title" class="section-title multiline">{t.sectionTitle}</h2>
        <div class="feature-list">
          {t.features.map((feature, index) => <article><span class="feature-number">0{index + 1}</span><h3>{feature.title}</h3><p>{feature.body}</p></article>)}
        </div>
      </section>

      <section class="showcase container" aria-labelledby="review-title">
        <div class="showcase-copy">
          <p class="eyebrow">{t.reviewLabel}</p>
          <h2 id="review-title" class="section-title multiline">{t.reviewTitle}</h2>
          <p>{t.reviewBody}</p>
          <a class="text-link" href={`${repository}/blob/main/docs/git.md`}>{t.reviewLink}<Arrow /></a>
        </div>
        <a class="showcase-image review-image" href={review.src} target="_blank" rel="noopener" aria-label={`${t.enlarge}: ${t.reviewLabel}`}>
          <Image src={review} alt={t.reviewAlt} widths={[640, 1024, 1664]} sizes="(max-width: 900px) 90vw, 60vw" format="webp" quality={90} loading="lazy" />
          <span class="image-open" aria-hidden="true"><Arrow direction="up-right" /></span>
        </a>
      </section>

      <section class="showcase usage-showcase container" aria-labelledby="usage-title">
        <div class="showcase-copy">
          <p class="eyebrow">{t.usageLabel}</p>
          <h2 id="usage-title" class="section-title multiline">{t.usageTitle}</h2>
          <p>{t.usageBody}</p>
          <a class="text-link" href={`${repository}/blob/main/docs/project-tools.md`}>{t.usageLink}<Arrow /></a>
          <p class="fine-print">{t.usageNote}</p>
        </div>
        <a class="showcase-image usage-image" href={usage.src} target="_blank" rel="noopener" aria-label={`${t.enlarge}: ${t.usageLabel}`}>
          <Image src={usage} alt={t.usageAlt} widths={[640, 1024, 1664]} sizes="(max-width: 900px) 90vw, 60vw" format="webp" quality={90} loading="lazy" />
          <span class="image-open" aria-hidden="true"><Arrow direction="up-right" /></span>
        </a>
      </section>
      <p class="demo-note container">{t.screenshotNote}</p>

      <section id="start" class="start-section" aria-labelledby="start-title">
        <div class="container start-grid">
          <div>
            <p class="eyebrow">{t.startLabel}</p>
            <h2 id="start-title" class="section-title multiline">{t.startTitle}</h2>
            <a class="button light" href={download}>{t.download}<Arrow direction="down" /></a>
            <a class="start-guide" href={guide}>{t.docs}<Arrow direction="up-right" /></a>
          </div>
          <ol class="steps">
            {t.steps.map((step, index) => <li><span aria-hidden="true">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}
          </ol>
        </div>
      </section>

      <section class="faq container" aria-labelledby="faq-title">
        <h2 id="faq-title" class="section-title">{t.faqTitle}</h2>
        <div class="faq-list">
          {t.faqs.map(item => <details><summary>{item.question}<span class="faq-plus" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}
        </div>
      </section>
    </main>

    <footer class="container site-footer">
      <div class="footer-top">
        <div><a class="brand" href={canonical.pathname}><img src={logo.src} width="30" height="30" alt="" /><span>Conduit</span></a><p>{t.footerTagline}</p></div>
        <nav aria-label={locale === 'zh' ? '页脚导航' : 'Footer navigation'}>
          <a href={repository}>GitHub</a><a href={guide}>{t.docs}</a><a href={`${repository}/issues`}>{t.issues}</a>
        </nav>
      </div>
      <div class="footer-bottom"><span>{t.attribution}</span><div><a href={`${repository}/blob/main/LICENSE`}>{t.license}</a><a href={`${base}third-party-notices.txt`}>{t.credits}</a></div></div>
    </footer>
  </body>
</html>
