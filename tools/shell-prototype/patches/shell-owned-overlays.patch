+//! Ownership and stop cleanup, separate from overlay presentation.
+use super::*;
+use std::collections::HashMap;
+
+#[derive(Default)]
+pub(super) struct OverlayState {
+    watches: Vec<(OverlayOwner, gpui::Task<()>)>,
+    pub(super) toasts: HashMap<SharedString, OverlayOwner>,
+    pub(super) fps: Option<OverlayOwner>,
+    tooltip: Option<(OverlayOwner, usize)>,
+}
+
+impl ShellRoot {
+    pub(crate) fn observe_overlay_owner(
+        &mut self,
+        owner: OverlayOwner,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if self
+            .ownership
+            .watches
+            .iter()
+            .any(|(seen, _)| seen == &owner)
+        {
+            return;
+        }
+        let stopped = owner.stopped();
+        let task = cx.spawn_in(window, async move |root, cx| {
+            let _ = stopped.recv().await;
+            let _ = root.update_in(cx, |root, window, cx| {
+                root.clear_stopped_overlays(window, cx)
+            });
+        });
+        self.ownership.watches.push((owner, task));
+    }
+
+    pub(super) fn content_owner(
+        &mut self,
+        content: &AnyView,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Option<OverlayOwner> {
+        let owner = OverlayOwner::current().or_else(|| {
+            content
+                .clone()
+                .downcast::<ScriptView>()
+                .ok()
+                .map(|view| view.read(cx).runtime().overlay_owner())
+        });
+        if let Some(owner) = &owner {
+            self.observe_overlay_owner(owner.clone(), window, cx);
+        }
+        owner
+    }
+
+    pub(super) fn caller_owns(owner: &Option<OverlayOwner>) -> bool {
+        OverlayOwner::current().is_none_or(|caller| owner.as_ref() == Some(&caller))
+    }
+
+    /// Synchronously release stopped VMs' overlays before a host shutdown/update
+    /// barrier. Stop also schedules this on the foreground executor; render
+    /// checks it again so a queued frame never draws a stopped script overlay.
+    pub fn clear_stopped_overlays(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        self.remove_owned_views(
+            |owner, _| owner.as_ref().is_some_and(OverlayOwner::is_stopped),
+            window,
+            cx,
+        );
+        let mut changed = false;
+        self.toasts.retain(|id, _| {
+            let keep = !self
+                .ownership
+                .toasts
+                .get(id)
+                .is_some_and(OverlayOwner::is_stopped);
+            changed |= !keep;
+            keep
+        });
+        self.ownership
+            .toasts
+            .retain(|id, _| self.toasts.get(id).is_some());
+        if self
+            .ownership
+            .fps
+            .as_ref()
+            .is_some_and(OverlayOwner::is_stopped)
+        {
+            self.fps_hud = None;
+            self.ownership.fps = None;
+            changed = true;
+        }
+        if self
+            .ownership
+            .tooltip
+            .as_ref()
+            .is_some_and(|(owner, _)| owner.is_stopped())
+        {
+            let (_, revision) = self.ownership.tooltip.as_ref().unwrap();
+            if self.tooltip_overlay.read(cx).request_revision() == *revision {
+                self.tooltip_overlay
+                    .update(cx, |overlay, cx| overlay.hide(cx));
+            }
+            self.ownership.tooltip = None;
+            changed = true;
+        }
+        self.ownership
+            .watches
+            .retain(|(owner, _)| !owner.is_stopped());
+        if changed {
+            cx.notify();
+        }
+    }
+
+    pub(super) fn remove_owned_views(
+        &mut self,
+        remove: impl Fn(&Option<OverlayOwner>, &FocusHandle) -> bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        // Keep removed handles alive while repairing targets, including a
+        // focused descendant of a removed dialog. Iterate through the whole
+        // chain: interleaved owners can point through several retired layers.
+        let mut removed = Vec::new();
+        for dialog in &self.dialogs {
+            if remove(&dialog.owner, &dialog.focus_handle) {
+                removed.push((dialog.focus_handle.clone(), dialog.restore_focus.clone()));
+            }
+        }
+        if let Some(sheet) = &self.sheet
+            && remove(&sheet.owner, &sheet.focus_handle)
+        {
+            removed.push((sheet.focus_handle.clone(), sheet.restore_focus.clone()));
+        }
+        if removed.is_empty() {
+            return;
+        }
+        let resolve = |mut target: Option<WeakFocusHandle>| {
+            for _ in 0..=removed.len() {
+                let Some(handle) = target.as_ref().and_then(|handle| handle.upgrade()) else {
+                    return None;
+                };
+                let Some((_, restore)) = removed
+                    .iter()
+                    .find(|(focus, _)| focus == &handle || focus.contains(&handle, window))
+                else {
+                    return target;
+                };
+                target = restore.clone();
+            }
+            None // A corrupt/cyclic focus record must not focus retired content.
+        };
+        let focused = window.focused(cx);
+        let lost_focus = focused.as_ref().is_some_and(|handle| {
+            removed
+                .iter()
+                .any(|(focus, _)| focus == handle || focus.contains(handle, window))
+        });
+        let restore = if lost_focus {
+            resolve(focused.map(|focus| focus.downgrade()))
+        } else {
+            None
+        };
+        self.dialogs
+            .retain(|dialog| !remove(&dialog.owner, &dialog.focus_handle));
+        for dialog in &mut self.dialogs {
+            dialog.restore_focus = resolve(dialog.restore_focus.take());
+        }
+        if self
+            .sheet
+            .as_ref()
+            .is_some_and(|sheet| remove(&sheet.owner, &sheet.focus_handle))
+        {
+            self.sheet = None;
+        }
+        if let Some(sheet) = &mut self.sheet {
+            sheet.restore_focus = resolve(sheet.restore_focus.take());
+        }
+        if lost_focus {
+            if restore.is_some() {
+                restore_focus(restore, window, cx);
+            } else if let Some(focus) = self
+                .dialogs
+                .last()
+                .map(|d| &d.focus_handle)
+                .or_else(|| self.sheet.as_ref().map(|s| &s.focus_handle))
+            {
+                focus.focus(window, cx);
+            } else {
+                window.blur(cx);
+            }
+        }
+        cx.notify();
+    }
+
+    pub(crate) fn show_owned_tooltip(
+        &mut self,
+        owner: OverlayOwner,
+        request: gpui_base::TooltipRequest,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if owner.is_stopped() {
+            return;
+        }
+        self.observe_overlay_owner(owner.clone(), window, cx);
+        let revision = self.tooltip_overlay.update(cx, |overlay, cx| {
+            overlay.request_show(request, window, cx);
+            overlay.request_revision()
+        });
+        self.ownership.tooltip = Some((owner, revision));
+    }
+
+    pub(crate) fn hide_owned_tooltip(
+        &mut self,
+        owner: &OverlayOwner,
+        immediate: bool,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let Some((current, revision)) = &self.ownership.tooltip else {
+            return;
+        };
+        if current != owner || self.tooltip_overlay.read(cx).request_revision() != *revision {
+            return;
+        }
+        let revision = self.tooltip_overlay.update(cx, |overlay, cx| {
+            if immediate {
+                overlay.hide(cx);
+            } else {
+                overlay.request_hide(window, cx);
+            }
+            overlay.request_revision()
+        });
+        self.ownership.tooltip = if immediate {
+            None
+        } else {
+            Some((owner.clone(), revision))
+        };
+    }
+}
