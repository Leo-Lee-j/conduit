@@ -0,0 +1,56 @@
+//! A runtime incarnation's revocable overlay identity. It never retains the VM.
+use std::{
+    rc::Rc,
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Debug)]
+pub(crate) struct OverlayOwner(Rc<Signal>);
+
+#[derive(Debug)]
+struct Signal {
+    id: u64,
+    sender: async_channel::Sender<()>,
+    receiver: async_channel::Receiver<()>,
+}
+
+impl Default for OverlayOwner {
+    fn default() -> Self {
+        let (sender, receiver) = async_channel::bounded(1);
+        let id = NEXT_ID
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+            .expect("overlay owner IDs exhausted");
+        Self(Rc::new(Signal {
+            id,
+            sender,
+            receiver,
+        }))
+    }
+}
+
+impl PartialEq for OverlayOwner {
+    fn eq(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+}
+impl Eq for OverlayOwner {}
+
+impl OverlayOwner {
+    pub(crate) fn current() -> Option<Self> {
+        crate::scope::current_runtime().map(|runtime| runtime.overlay_owner())
+    }
+    pub(crate) fn stop(&self) {
+        self.0.sender.close();
+    }
+    pub(crate) fn is_stopped(&self) -> bool {
+        self.0.sender.is_closed()
+    }
+    pub(crate) fn stopped(&self) -> async_channel::Receiver<()> {
+        self.0.receiver.clone()
+    }
+    pub(crate) fn toast_id(&self, id: &str) -> gpui::SharedString {
+        format!("shell-owner-{}:{id}", self.0.id).into()
+    }
+}
