+/// A rejection value, already rendered as a message.
+pub(super) fn observe_command<'js>(
+    ctx: &Ctx<'js>,
+    promise: &Promise<'js>,
+    sender: async_channel::Sender<super::commands::Reply>,
+) -> JsResult<()> {
+    let cancelled = sender.clone();
+    let task = register(
+        ctx,
+        TaskState::new(
+            "view.on_command",
+            scope::current_view().map(|view| view.downgrade()),
+            None,
+        )
+        .with_cancellation(move || {
+            let _ = cancelled.try_send(Err("command cancelled".into()));
+        }),
+    )?;
+    let settled = task.clone();
+    let failed = task.clone();
+    let rejected = sender.clone();
+    let result = promise.then().and_then(|then| {
+        then.call::<_, ()>((
+            This(promise.clone()),
+            Func::from(move |reply: super::commands::CommandValue| {
+                let value = if matches!(settled.readiness(), Readiness::Ready(_)) {
+                    reply.0
+                } else {
+                    Err("command cancelled".into())
+                };
+                let _ = sender.try_send(value);
+                finish(&settled);
+            }),
+            Func::from(move |failure: super::commands::CommandFailure| {
+                let _ = rejected.try_send(Err(failure.0));
+                finish(&failed);
+            }),
+        ))
+    });
+    if result.is_err() {
+        finish(&task);
+    }
+    result
 }
 
