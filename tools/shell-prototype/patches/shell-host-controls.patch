+//! Host-selected limits for one isolated interpreter. Native host work must
+//! still be bounded by the embedding application; it cannot be preempted here.
+use std::{
+    cell::{Cell, RefCell},
+    collections::VecDeque,
+    rc::Rc,
+    time::{Duration, Instant},
+};
+
+use crate::ScopePhase;
+
+/// A resource envelope for a single plugin VM. Use a separate VM per owner.
+#[derive(Clone, Debug)]
+pub struct RuntimeLimits {
+    pub heap_bytes: usize,
+    pub stack_bytes: usize,
+    pub render: Duration,
+    pub event: Duration,
+    pub module: Duration,
+    pub window: Duration,
+    pub execution_per_window: Duration,
+    pub calls_per_window: usize,
+    pub native_calls_per_entry: usize,
+    pub snapshot_nodes: usize,
+    pub snapshot_depth: usize,
+    pub bridge_values_per_entry: usize,
+    pub bridge_bytes_per_entry: usize,
+    pub logs_per_window: usize,
+    pub log_bytes_per_window: usize,
+}
+
+impl Default for RuntimeLimits {
+    fn default() -> Self {
+        Self {
+            heap_bytes: 64 << 20,
+            stack_bytes: 512 << 10,
+            render: Duration::from_millis(25),
+            event: Duration::from_millis(50),
+            module: Duration::from_millis(100),
+            window: Duration::from_secs(1),
+            execution_per_window: Duration::from_millis(200),
+            calls_per_window: 4096,
+            native_calls_per_entry: 20_000,
+            snapshot_nodes: 2048,
+            snapshot_depth: 64,
+            bridge_values_per_entry: 20_000,
+            bridge_bytes_per_entry: 1 << 20,
+            logs_per_window: 100,
+            log_bytes_per_window: 64 << 10,
+        }
+    }
+}
+
+impl RuntimeLimits {
+    pub(crate) fn validate(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            self.heap_bytes >= 4 << 20 && self.stack_bytes >= 64 << 10,
+            "heap/stack limits are too small to initialize the interpreter"
+        );
+        anyhow::ensure!(
+            !self.render.is_zero()
+                && !self.event.is_zero()
+                && !self.module.is_zero()
+                && !self.window.is_zero()
+                && !self.execution_per_window.is_zero()
+                && self.execution_per_window <= self.window
+                && self.calls_per_window > 0
+                && self.native_calls_per_entry > 0
+                && self.snapshot_nodes > 0
+                && self.snapshot_depth > 0
+                && self.bridge_values_per_entry > 0
+                && self.bridge_bytes_per_entry > 0
+                && self.logs_per_window > 0
+                && self.log_bytes_per_window > 0,
+            "runtime limits must be positive and bounded"
+        );
+        Ok(())
+    }
+
+    fn deadline(&self) -> Duration {
+        match crate::scope::current_phase() {
+            Some(ScopePhase::Render | ScopePhase::Layout) => self.render,
+            Some(ScopePhase::Event | ScopePhase::Task) => self.event,
+            None => self.module,
+        }
+    }
+}
+
+pub(crate) struct Resources {
+    pub limits: RuntimeLimits,
+    pub enabled: Cell<bool>,
+    fault: Cell<Option<&'static str>>,
+    active: Cell<Option<(Instant, Duration)>>,
+    samples: RefCell<VecDeque<(Instant, Duration)>>,
+    used: Cell<Duration>,
+    native_calls: Cell<usize>,
+    bridge_values: Cell<usize>,
+    bridge_bytes: Cell<usize>,
+    logs: RefCell<VecDeque<(Instant, usize)>>,
+}
+
+impl Resources {
+    pub fn new(limits: RuntimeLimits) -> Rc<Self> {
+        Rc::new(Self {
+            limits,
+            enabled: Cell::new(false),
+            fault: Cell::new(None),
+            active: Cell::new(None),
+            samples: RefCell::new(VecDeque::new()),
+            used: Cell::new(Duration::ZERO),
+            native_calls: Cell::new(0),
+            bridge_values: Cell::new(0),
+            bridge_bytes: Cell::new(0),
+            logs: RefCell::new(VecDeque::new()),
+        })
+    }
+
+    pub fn fail(&self, reason: &'static str) -> anyhow::Error {
+        self.fault.set(self.fault.get().or(Some(reason)));
+        anyhow::anyhow!("script runtime disabled: {}", self.fault.get().unwrap())
+    }
+
+    pub fn error(&self) -> Option<anyhow::Error> {
+        self.fault
+            .get()
+            .map(|reason| anyhow::anyhow!("script runtime disabled: {reason}"))
+    }
+
+    pub fn check(&self) -> anyhow::Result<()> {
+        if !self.enabled.get() {
+            return Ok(());
+        }
+        if let Some(error) = self.error() {
+            return Err(error);
+        }
+        if let Some((started, deadline)) = self.active.get() {
+            let elapsed = started.elapsed();
+            if elapsed >= deadline {
+                return Err(self.fail("execution deadline exceeded"));
+            }
+            if self.used.get().saturating_add(elapsed) >= self.limits.execution_per_window {
+                return Err(self.fail("cumulative execution budget exceeded"));
+            }
+        }
+        Ok(())
+    }
+
+    pub fn enter(self: &Rc<Self>) -> anyhow::Result<Execution> {
+        self.enter_with_limit(self.limits.deadline())
+    }
+
+    pub fn enter_module(self: &Rc<Self>) -> anyhow::Result<Execution> {
+        self.enter_with_limit(self.limits.module)
+    }
+
+    pub fn enter_materialize(self: &Rc<Self>) -> anyhow::Result<Execution> {
+        self.enter_with_limit(self.limits.render)
+    }
+
+    pub fn validate_tree(
+        &self,
+        arena: &crate::spec::SpecArena,
+        root: crate::spec::SpecId,
+    ) -> anyhow::Result<()> {
+        let mut pending = vec![(root, 0)];
+        let mut expanded = 0usize;
+        let mut operations = 0usize;
+        while let Some((id, depth)) = pending.pop() {
+            self.check()?;
+            expanded += 1;
+            if expanded > self.limits.snapshot_nodes || depth > self.limits.snapshot_depth {
+                return Err(self.fail("snapshot expansion/depth limit exceeded"));
+            }
+            let Some(node) = arena.node(id) else {
+                continue;
+            };
+            operations = operations.saturating_add(node.ops().len());
+            if operations > self.limits.native_calls_per_entry {
+                return Err(self.fail("snapshot operation limit exceeded"));
+            }
+            for child in node
+                .children()
+                .iter()
+                .copied()
+                .chain(node.ops().iter().filter_map(|op| match op {
+                    crate::spec::SpecOp::StateStyle(_, child)
+                    | crate::spec::SpecOp::Slot(_, child) => Some(*child),
+                    _ => None,
+                }))
+            {
+                if pending.len() + expanded >= self.limits.snapshot_nodes {
+                    return Err(self.fail("snapshot expansion/depth limit exceeded"));
+                }
+                pending.push((child, depth + 1));
+            }
+        }
+        Ok(())
+    }
+
+    fn enter_with_limit(self: &Rc<Self>, limit: Duration) -> anyhow::Result<Execution> {
+        self.check()?;
+        let outer = self.enabled.get() && self.active.get().is_none();
+        if outer {
+            let now = Instant::now();
+            let mut samples = self.samples.borrow_mut();
+            while samples
+                .front()
+                .is_some_and(|(at, _)| now.duration_since(*at) >= self.limits.window)
+            {
+                let (_, duration) = samples.pop_front().unwrap();
+                self.used.set(self.used.get().saturating_sub(duration));
+            }
+            if samples.len() >= self.limits.calls_per_window {
+                return Err(self.fail("entry rate exceeded"));
+            }
+            if self.used.get() >= self.limits.execution_per_window {
+                return Err(self.fail("cumulative execution budget exceeded"));
+            }
+            self.native_calls.set(0);
+            self.bridge_values.set(0);
+            self.bridge_bytes.set(0);
+            self.active.set(Some((now, limit)));
+        }
+        Ok(Execution {
+            resources: self.clone(),
+            outer,
+        })
+    }
+
+    pub fn native_call(&self, nodes: usize) -> anyhow::Result<()> {
+        self.check()?;
+        if !self.enabled.get() {
+            return Ok(());
+        }
+        let count = self.native_calls.get().saturating_add(1);
+        self.native_calls.set(count);
+        if count > self.limits.native_calls_per_entry || nodes >= self.limits.snapshot_nodes {
+            return Err(self.fail("native description limit exceeded"));
+        }
+        Ok(())
+    }
+
+    pub fn bridge_value(&self) -> anyhow::Result<()> {
+        self.check()?;
+        if !self.enabled.get() {
+            return Ok(());
+        }
+        let count = self.bridge_values.get().saturating_add(1);
+        self.bridge_values.set(count);
+        if count > self.limits.bridge_values_per_entry {
+            return Err(self.fail("host data conversion limit exceeded"));
+        }
+        Ok(())
+    }
+
+    pub fn log(&self, bytes: usize) -> anyhow::Result<()> {
+        self.check()?;
+        if !self.enabled.get() {
+            return Ok(());
+        }
+        let now = Instant::now();
+        let mut logs = self.logs.borrow_mut();
+        while logs
+            .front()
+            .is_some_and(|(at, _)| now.duration_since(*at) >= self.limits.window)
+        {
+            logs.pop_front();
+        }
+        if logs.len() >= self.limits.logs_per_window
+            || bytes.saturating_add(logs.iter().map(|(_, bytes)| bytes).sum())
+                > self.limits.log_bytes_per_window
+        {
+            return Err(self.fail("script log limit exceeded"));
+        }
+        logs.push_back((now, bytes));
+        Ok(())
+    }
+
+    pub fn bridge_bytes(&self, bytes: usize) -> anyhow::Result<()> {
+        self.check()?;
+        if !self.enabled.get() {
+            return Ok(());
+        }
+        let count = self.bridge_bytes.get().saturating_add(bytes);
+        self.bridge_bytes.set(count);
+        if count > self.limits.bridge_bytes_per_entry {
+            return Err(self.fail("host data byte limit exceeded"));
+        }
+        Ok(())
+    }
+}
+
+pub(crate) struct Execution {
+    resources: Rc<Resources>,
+    outer: bool,
+}
+
+impl Drop for Execution {
+    fn drop(&mut self) {
+        if self.outer {
+            let _ = self.resources.check();
+            if let Some((started, _)) = self.resources.active.take() {
+                let duration = started.elapsed();
+                self.resources
+                    .used
+                    .set(self.resources.used.get().saturating_add(duration));
+                self.resources
+                    .samples
+                    .borrow_mut()
+                    .push_back((Instant::now(), duration));
+            }
+        }
+    }
+}
